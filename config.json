{
  "default_agent": "opencode",
  "default_model": "opencode/big-pickle",
  "default_workspace": "D:\\free_project",
  "safe_mode": true,
  "project_roots": [
    "D:\\free_project",
    "D:\\free_project\\laragon\\www"
  ],
  "saved_projects": {
    "free_project": "D:\\free_project",
    "www": "D:\\free_project\\laragon\\www",
    "bot": "D:\\AI BOT"
  },
  "agents": {
    "opencode": {
      "name": "OpenCode AI CLI",
      "command": [
        "opencode",
        "run",
        "--thinking",
        "--auto",
        "{prompt}"
      ],
      "continue_flag": "-c",
      "file_flag": "-f",
      "model_flag": "-m",
      "readonly_flags": [
        "--agent",
        "plan"
      ],
      "write_flags": [
        "--agent",
        "build"
      ],
      "description": "Menjalankan OpenCode CLI dengan Live Thinking & Plan/Build Mode"
    },
    "agy": {
      "name": "Google Antigravity CLI",
      "command": [
        "agy",
        "-p",
        "{prompt}"
      ],
      "continue_flag": "-c",
      "model_flag": "--model",
      "readonly_flags": [
        "--mode",
        "plan"
      ],
      "write_flags": [
        "--mode",
        "accept-edits"
      ],
      "description": "Menjalankan Google Antigravity Agent pada folder aktif"
    },
    "claude": {
      "name": "Claude Code CLI",
      "command": [
        "claude",
        "-p",
        "{prompt}"
      ],
      "continue_flag": "-c",
      "model_flag": "--model",
      "description": "Menjalankan Claude Code CLI dalam mode non-interaktif"
    },
    "aider": {
      "name": "Aider AI Pair Programmer",
      "command": [
        "aider",
        "--message",
        "{prompt}",
        "--yes"
      ],
      "model_flag": "--model",
      "description": "Menjalankan Aider otomatis dengan pesan prompt"
    },
    "codex": {
      "name": "OpenAI Codex CLI",
      "command": [
        "codex",
        "-q",
        "{prompt}"
      ],
      "description": "Menjalankan OpenAI Codex CLI"
    },
    "gemini": {
      "name": "Gemini CLI",
      "command": [
        "gemini",
        "-p",
        "{prompt}"
      ],
      "model_flag": "-m",
      "description": "Menjalankan Gemini CLI"
    }
  }
}
